# Copy this file to .env and fill in real values before running against
# real client material. .env is git-ignored.

# Random long string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
VICLONE_SECRET_KEY=

# Login password for the app. If left empty, the app runs WITHOUT a login
# gate -- only acceptable for a quick local trial with no real data loaded.
VICLONE_PASSWORD=

# Max upload size in MB (audio/video reference files).
VICLONE_MAX_UPLOAD_MB=500

# Set to "true" only once rvc_bridge/realtime.py has been wired to a real,
# verified voice-conversion engine (see README). Until then, live
# conversion is a passthrough and the UI will say so.
VICLONE_LIVE_ENGINE_IMPLEMENTED=false
